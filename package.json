{
  "name": "pose-coach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pose Coach - On-device AI Pose Estimation and Interactive Coaching Desktop Application",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && concurrently -k \"vite\" \"electron .\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "copy:wasm": "node tools/copy_wasm.js",
    "postinstall": "node tools/copy_wasm.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.0.21",
    "@mediapipe/tasks-vision": "0.10.14",
    "lucide-react": "0.439.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.46.1",
    "@types/node": "20.14.10",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "10.4.20",
    "concurrently": "8.2.2",
    "electron": "31.3.1",
    "electron-builder": "24.13.3",
    "postcss": "8.4.41",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "vitest": "2.0.5"
  }
}
